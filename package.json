{
  "name": "n8n-v3-check",
  "version": "0.1.0",
  "description": "Offline checker for n8n workflow JSON: finds nodes and settings that n8n 3.0 removes or changes",
  "type": "module",
  "bin": {
    "n8n-v3-check": "dist/cli.js"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "census:collect": "node census/collect.mjs",
    "census:analyze": "npm run build && node census/analyze.mjs",
    "prepare": "tsc -p tsconfig.build.json",
    "census:charts": "node census/charts.mjs"
  },
  "keywords": [
    "n8n",
    "n8n-3",
    "migration",
    "workflow",
    "lint",
    "cli"
  ],
  "author": "Sunnatulla E",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atokim4/n8n-v3-check.git"
  }
}
